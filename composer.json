{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "qiick/laravel-api-keys",
    "description": "Contract-only API key mechanics for qiick Laravel products: issue, parse, verify, scopes, IP allowlist, rotation, and RFC 6750 refusals.",
    "type": "library",
    "keywords": [
        "qiick",
        "laravel",
        "api-keys",
        "bearer",
        "scopes",
        "rfc6750"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Qiick",
            "homepage": "https://qiick.io"
        }
    ],
    "homepage": "https://github.com/qiick-io/laravel-api-keys",
    "support": {
        "issues": "https://github.com/qiick-io/laravel-api-keys/issues",
        "source": "https://github.com/qiick-io/laravel-api-keys"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/notifications": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.3",
        "laravel/pint": "^1.30",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-mutate": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Qiick\\ApiKeys\\Laravel\\ApiKeysServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Qiick\\ApiKeys\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qiick\\ApiKeys\\Tests\\": "tests/"
        },
        "files": [
            "src/Testing/functions.php"
        ]
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
